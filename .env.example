# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Clarifai API (Food Recognition)
VITE_CLARIFAI_PAT=your_clarifai_personal_access_token
VITE_CLARIFAI_USER_ID=clarifai
VITE_CLARIFAI_APP_ID=main
VITE_CLARIFAI_MODEL_ID=food-item-recognition

# Nutritionix API (Calorie Data)
VITE_NUTRITIONIX_APP_ID=your_nutritionix_app_id
VITE_NUTRITIONIX_API_KEY=your_nutritionix_api_key
